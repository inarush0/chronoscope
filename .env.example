# Local SQLite dataset built by chronoscope-infra (`bun run build-db`).
DATABASE_FILE=../chronoscope-infra/data/chronoscope.sqlite

# Re-open the dataset when the file changes, so `bun run build-db` shows up
# without a restart. Local iteration only — leave unset in production.
DATASET_RELOAD=1

# Alternative to DATABASE_FILE: fetch the dataset from object storage on first
# request and cache it on local disk. DATABASE_FILE wins if both are set.
# DATABASE_URL=https://your-bucket.s3.amazonaws.com/chronoscope.sqlite
# DATASET_CACHE_DIR=/tmp/chronoscope

ORIGIN=http://localhost:3000
DEFAULT_DATASET=bible
