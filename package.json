{
  "name": "chronoscope",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev --open",
    "build": "vite build",
    "build:binary": "npm run build && go build -o chronoscope .",
    "build:linux": "npm run build && GOOS=linux GOARCH=amd64 go build -o chronoscope-linux-amd64 .",
    "preview": "vite preview",
    "check": "tsc -p tsconfig.json",
    "format": "prettier --write \"src/**/*.{ts,css}\"",
    "check:dataset": "tsc -p dataset/tsconfig.json",
    "build-db": "bun dataset/build.ts",
    "validate": "bun dataset/validate.ts",
    "check:artifact": "bun dataset/check-artifact.ts"
  },
  "devDependencies": {
    "@types/d3-scale": "^4.0.9",
    "@types/d3-time": "^3.0.4",
    "@types/node": "^25.6.0",
    "bun-types": "^1.4.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "d3-scale": "^4.0.2",
    "d3-time": "^3.1.0",
    "pixi.js": "^8.16.0"
  }
}
