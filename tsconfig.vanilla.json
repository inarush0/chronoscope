// Type-checks the vanilla-TS app without SvelteKit's generated config
// (`tsconfig.json` extends `.svelte-kit/tsconfig.json`, which only exists after
// `svelte-kit sync`). Becomes the single root tsconfig once Svelte is gone.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src/main.ts",
    "src/fixture.ts",
    "src/lib/timeline/*.ts",
    "vite.vanilla.config.ts"
  ]
}
